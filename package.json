{
    "name": "telechargement-climatologie-meteo-data-gouv",
    "version": "1.0.0",
    "description": "Téléchargement des données de climatologie de meteo.data.gouv.fr",
    "type": "module",
    "main": "index.js",
    "keywords": [
        "Infoclimat",
        "Météo-France"
    ],
    "author": "Jean LECORDIER",
    "license": "UNLICENSED",
    "scripts": {
        "check": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint --fix .",
        "format": "prettier --write .",
        "test:unit": "vitest --project unit",
        "test:integration": "pnpm run deploy:dev && vitest run --project integration --no-file-parallelism",
        "test:all": "pnpm run deploy:dev && vitest run --no-file-parallelism",
        "test:ci": "pnpm run deploy:dev && vitest run --no-file-parallelism",
        "coverage": "pnpm run deploy:dev && vitest run --coverage",
        "migrate:dev": "prisma migrate dev",
        "migrate:preprod": "dotenv -e .env.preprod -- prisma migrate dev",
        "deploy:dev": "prisma migrate deploy",
        "deploy:preprod": "dotenv -e .env.preprod -- prisma migrate deploy",
        "prepare": "husky",
        "start-docker": "docker compose --file db/compose.yaml up -d",
        "update-all-archives": "tsx src/apps/download/updateAllArchives.ts",
        "download-missing-archives": "tsx src/apps/download/downloadMissingArchives.ts",
        "unzip-all-archives": "tsx src/apps/unzip/unzipAllArchives.ts",
        "unzip-remaining-archives": "tsx src/apps/unzip/unzipRemainingArchives.ts",
        "save-all-csvs-to-db-sequentially": "tsx src/apps/save/saveAllCSVsToDB.ts",
        "save-all-csvs-to-db-sequentially:preprod": "pnpm run deploy:preprod && dotenv -e .env.preprod -- tsx src/apps/save/saveAllCSVsToDB.ts",
        "save-all-csvs-to-db-in-parallel": "bash scripts/save-all-csvs-to-db-in-parallel.sh",
        "save-all-csvs-to-db-in-parallel:preprod": "pnpm run deploy:preprod && dotenv -e .env.preprod -- bash scripts/save-all-csvs-to-db-in-parallel.sh",
        "unzip-save-delete-all-csvs-in-parallel": "bash scripts/unzip-save-delete-all-csvs-in-parallel.sh",
        "unzip-save-delete-all-csvs-in-parallel:preprod": "pnpm run deploy:preprod && dotenv -e .env.preprod -- bash scripts/unzip-save-delete-all-csvs-in-parallel.sh"
    },
    "lint-staged": {
        "*.html": "prettier --write --ignore-unknown",
        "*.{js,ts}": [
            "eslint --fix",
            "prettier --write --ignore-unknown",
            "pnpm run deploy:dev",
            "vitest related --run --no-file-parallelism"
        ]
    },
    "dependencies": {
        "@prisma/client": "6.4.1",
        "axios": "^1.8.1",
        "decompress-targz": "^4.1.1",
        "decompress-unzip": "^4.0.1",
        "dotenv": "^16.4.7",
        "download": "^8.0.0",
        "glob": "^11.0.1",
        "p-queue": "^8.1.0",
        "pino": "^9.6.0",
        "typescript": "^5.8.2",
        "zod": "^3.24.2"
    },
    "devDependencies": {
        "@eslint/js": "^9.21.0",
        "@types/download": "^8.0.5",
        "@types/eslint-config-prettier": "^6.11.3",
        "@types/node": "^22.13.9",
        "dotenv-cli": "^8.0.0",
        "eslint": "^9.21.0",
        "eslint-config-prettier": "^10.0.2",
        "globals": "^16.0.0",
        "husky": "^9.1.7",
        "lint-staged": "^15.4.3",
        "prettier": "^3.5.3",
        "prisma": "^6.4.1",
        "testcontainers": "^10.18.0",
        "tsx": "^4.19.3",
        "typescript-eslint": "^8.26.0",
        "vitest": "^3.0.7"
    }
}
